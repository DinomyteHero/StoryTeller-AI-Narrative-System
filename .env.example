# ── Mode ──────────────────────────────────────────────────────────────────────
NARRATIVE_BACKEND=cloud            # cloud | local

# ── Cloud narration (NARRATIVE_BACKEND=cloud) ─────────────────────────────────
CLOUD_PROVIDER=openai              # openai | openrouter
CLOUD_MODEL=gpt-5.2

# OpenAI
OPENAI_API_KEY=sk-...

# OpenRouter (uncomment if CLOUD_PROVIDER=openrouter)
# OPENROUTER_API_KEY=sk-or-...

# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
LOCAL_MODEL=qwen3.5:9b             # check decisions (structured JSON)
LOCAL_NARRATION_MODEL=ministral-3:8b  # narration when NARRATIVE_BACKEND=local
                                      # (defaults to LOCAL_MODEL if omitted)

# ── Database ──────────────────────────────────────────────────────────────────
DB_PATH=./data/storyteller.db

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000
DEV_MODE=true
STREAMING_ENABLED=true
