# ── Cloud provider & API key ──────────────────────────────────────────────────
# Default path: OpenRouter with DeepSeek V4 models. Switch to direct OpenAI
# by setting CLOUD_PROVIDER=openai and OPENAI_API_KEY.
CLOUD_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-...

# Two-tier model routing:
#   FAST    — structured JSON, decisions, annotations, reconciliation,
#             scene validation. High-volume, latency-sensitive.
#   QUALITY — turn narration, milestone reflections, time-skip prose,
#             studio generation. Quality-critical, latency-tolerant.
FAST_MODEL=deepseek/deepseek-v4-flash
QUALITY_MODEL=deepseek/deepseek-v4-pro

# Per-call-site overrides (optional). Empty = inherit from tier default.
# Set these to A/B individual calls without touching tier config.
NARRATION_MODEL=deepseek/deepseek-v4-flash
# DECISION_MODEL=
# ANNOTATION_MODEL=
# RECONCILIATION_MODEL=
# DIAGNOSTIC_MODEL=
# MILESTONE_MODEL=
# STUDIO_MODEL=
# MEMORY_MODEL=
# CHOICE_QUALITY_MODEL=
# CHOICE_REPAIR_MODEL=
# DRIFT_MODEL=
# POLARITY_MODEL=
# EPILOGUE_MODEL=
# RECAP_MODEL=

# OpenRouter app attribution (shows up in your dashboard).
OPENROUTER_APP_NAME=Storyteller-V3
OPENROUTER_APP_URL=https://github.com/storyteller-v3

# Optional OpenRouter provider routing.
# Useful when one endpoint for a model is rate-limiting or drifting.
# Provider slugs come from the model detail page copy button.
# Example for DeepSeek V4 Flash live testing:
# OPENROUTER_PROVIDER_ORDER=deepseek,siliconflow,novita
# OPENROUTER_PROVIDER_IGNORE=deepinfra
# OPENROUTER_ALLOW_FALLBACKS=true
# OPENROUTER_PROVIDER_SORT=
# OPENROUTER_PROVIDER_ONLY=

# Legacy single-cloud-model knob — if set, overrides QUALITY_MODEL.
# Kept for back-compat with older deployments. Leave commented unless needed.
# CLOUD_MODEL=gpt-5.2

# Direct OpenAI (only if CLOUD_PROVIDER=openai).
# OPENAI_API_KEY=sk-...

# ── Token / reasoning budgets ─────────────────────────────────────────────────
# Live narration gets its own smaller budget. Keep MAX_COMPLETION_TOKENS
# larger for milestone/studio calls that are not in the player hot path.
NARRATION_MAX_TOKENS=1200
NARRATION_MIN_WORDS=150
NARRATION_MAX_WORDS=750
NARRATION_TIMEOUT_SEC=45
NARRATION_PARSE_RETRIES=1
NARRATION_PROVIDER_RETRIES=3
NARRATION_PROVIDER_BACKOFF_SEC=2
MAX_COMPLETION_TOKENS=16000

# Hot-path quality gates. Enable when calibrating; leave off for live play.
TAGGED_CHOICE_DECISIONS=true
CHOICE_QUALITY_INLINE=true
PROSE_DIAGNOSTIC_INLINE=false
CHOICE_ANNOTATION_ENABLED=false
ANNOTATION_JOIN_TIMEOUT_SEC=0.2
RECONCILIATION_TIMEOUT_SEC=25
RECONCILIATION_MAX_TOKENS=800
RECONCILIATION_RETRIES=1
RECONCILIATION_INLINE=false
LLM_TIMING_LOG=true
# Per-call token usage logging (LLM_USAGE lines + /health usage_totals).
# Surfaces provider prefix-cache hits — the signal that prompt caching works.
LLM_USAGE_LOG=true
# Rule 4 enforcement: on failed checks, a tiny fast-tier post-check verifies
# the prose actually depicts failure; a mismatch retries the narration once.
# Adds ~1 small fast-tier call only on failed-check turns.
DICE_POLARITY_CHECK=true
# "The story so far" recap on session resume — one fast-tier call, cached
# per turn-count in the session row. Disable for eval harness runs.
RESUME_RECAP_ENABLED=true

# Only honored by reasoning models (gpt-o*, gpt-5*). Ignored by DeepSeek.
REASONING_EFFORT=low

# ── Database ──────────────────────────────────────────────────────────────────
DB_PATH=./data/storyteller.db

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000
DEV_MODE=true
STREAMING_ENABLED=true

# ── Prose voice ───────────────────────────────────────────────────────────────
# clean    — direct, grounded (default)
# literary — Stover/Luceno blend
PROSE_VOICE=clean

# ── CS-6 Scene purpose validation ─────────────────────────────────────────────
# Adds one fast-tier call per turn after reconciliation. Scores narration
# against its dramatic mission on five dimensions and emits a
# scene_validation telemetry event. Quality signal only — never blocks
# delivery. Off by default; enable for eval runs.
SCENE_VALIDATOR_ENABLED=false
